{
  "name": "chat-selfhosted",
  "author": "Bruno Jardon",
  "version": "0.0.1",
  "description": "Private self-hosted chat monorepo",
  "keywords": [],
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm -r --parallel --if-present run start",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "format": "pnpm -r --if-present run format",
    "format:fix": "pnpm -r --if-present run format:fix",
    "typecheck": "pnpm -r --if-present run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml}": "prettier --write"
  }
}
