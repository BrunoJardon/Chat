    "format": "prettier --check src/",
    "format:fix": "prettier --write src/"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@12.3.4"
